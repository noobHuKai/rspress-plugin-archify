  "peerDependencies": {
    "@rspress/core": "^2.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@rspress/core": "^2.0.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^5.9.3"
  }
}
